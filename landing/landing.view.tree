$piterjs_landing $mol_view
	meetup $piterjs_meetup
	meetups /
	attr *
		^
		piterjs_landing_menu <= menu_open false
	nav_titles *
		hero \Главная
		manifesto \Манифест
		schedule \Доклады
		archive \Архив
		community \Сообщество
	filter_titles *
		all \Все
		piterjs \PiterJS
		piterux \PiterUX
		conf \Conf
	timer_titles *
		days \Дней
		hours \Часов
		minutes \Минут
		seconds \Секунд
	venue_icons *
		address \📍
		route \🚇
		notes \🚶
	social_uris *
		github \https://github.com/piterjs
		telegram \https://t.me/piterjs
		youtube \https://www.youtube.com/@piterjs
		vk \https://vk.com/piterjs
	community_titles *
		telegram \@piterjs // Чат и Анонсы
		vk \vk.com/piterjs // Записи и Медиа
	community_texts *
		telegram \Крупнейшее JS-сообщество Санкт-Петербурга. Обсуждения, вакансии и оперативные новости.
		vk \Видеозаписи докладов, фотоотчёты со встреч и анонсы новых митапов.
	community_actions *
		telegram \[ Вступить в Telegram-канал ]
		vk \[ Открыть группу VK ]
	community_badges *
		telegram \TELEGRAM COMMUNITY
		vk \VK COMMUNITY
	social_hints *
		github \GitHub
		telegram \Telegram
		youtube \YouTube
		vk \VK Video
	sub /
		<= Head $mol_view
			dom_name \header
			sub /
				<= Head_row $mol_view
					sub /
						<= Logo $mol_link
							uri \#hero
							click? <=> menu_close? null
							sub /
								<= Logo_icon $mol_image
									uri \/piterjs/landing/assets/logo.webp
								<= Logo_name $mol_view sub / \PITERJS
								<= Logo_tag $mol_view sub / <= meetup_tag \
						<= Nav $mol_view
							dom_name \nav
							sub <= nav_links /
						<= Head_tools $mol_view
							sub /
								<= Back $mol_link
									arg * landing null
									sub / \[ Все митапы ]
								<= Join_link $mol_link
									uri \#register
									click? <=> menu_close? null
									sub / <= join_link_title \
								<= Burger $mol_button_minor
									click? <=> menu_toggle? null
									sub /
										<= Burger_bar_1 $mol_view
										<= Burger_bar_2 $mol_view
										<= Burger_bar_3 $mol_view
		<= Main $mol_view
			dom_name \main
			sub /
				<= Hero $mol_view
					attr * id \hero
					sub /
						<= Hero_video $mol_view
							dom_name \video
							attr *
								poster \/piterjs/landing/assets/hero_poster.webp
								src \/piterjs/landing/assets/background.mp4
							field *
								autoplay true
								loop true
								muted true
								playsInline true
						<= Hero_scrim $mol_view
						<= Hero_body $mol_view
							sub /
								<= Hero_badge $mol_view sub / <= hero_badge \
								<= Hero_title $mol_view
									sub /
										<= Hero_title_top $mol_view sub / \SAINT PETERSBURG
										<= Hero_title_bottom $mol_view
											sub /
												<= Hero_title_accent $mol_view sub / \JAVASCRIPT
												<= Hero_title_rest $mol_view sub / \COMMUNITY
								<= Hero_lead $mol_view
									sub / \Сообщество разработчиков, создающих будущее веба. Живые встречи, глубокие хардкорные доклады, нетворк и технологический драйв в самом сердце Санкт-Петербурга.
								<= Hero_grid $mol_view
									sub /
										<= Countdown $mol_view
											sub /
												<= Countdown_title $mol_view sub / \ДО СЛЕДУЮЩЕЙ ВСТРЕЧИ ОСТАЛОСЬ:
												<= Countdown_units $mol_view
													sub <= countdown_units /
										<= Event $mol_view
											attr * id \register
											sub /
												<= Event_badge $mol_view sub / \NEXT EVENT
												<= Event_title $mol_view sub / <= event_title \
												<= Event_time $mol_view sub / <= event_time \
												<= Event_place $mol_view sub / <= event_place \
												<= Event_map $mol_link
													uri <= map_uri \
													target \_blank
													sub / \[ На карте ]
												<= Join $mol_view
													sub <= join_content /
				<= Manifesto $mol_view
					attr * id \manifesto
					sub /
						<= Manifesto_body $mol_view
							sub /
								<= Manifesto_quote $mol_view
									sub / \«МЫ ПИШЕМ КОД БУДУЩЕГО В СТОЛИЦЕ МОСТОВ И ВЕБ-ТЕХНОЛОГИЙ. БЕЗ СУЕТЫ. БЕЗ ФИЛЬТРОВ. С МАКСИМАЛЬНОЙ ИНЖЕНЕРНОЙ ТОЧНОСТЬЮ»
								<= Stats $mol_view
									sub /
										<= Stat_meetups $mol_view
											sub /
												<= Stat_meetups_value $mol_view sub / <= meetups_count \
												<= Stat_meetups_title $mol_view sub / \Митапов в архиве
										<= Stat_open $mol_view
											sub /
												<= Stat_open_value $mol_view sub / \100%
												<= Stat_open_title $mol_view sub / \Open Source & Community
				<= Schedule $mol_view
					attr * id \schedule
					sub /
						<= Schedule_body $mol_view
							sub /
								<= Schedule_title $mol_view sub / <= schedule_title \
								<= Schedule_lead $mol_view sub / <= schedule_lead \
								<= Talks $mol_view
									sub <= talks /
								<= Cfp $mol_view
									sub /
										<= Cfp_badge $mol_view sub / \CALL FOR PAPERS
										<= Cfp_title $mol_view sub / \ХОТИТЕ ВЫСТУПИТЬ С ДОКЛАДОМ НА СЛЕДУЮЩЕМ МИТАПЕ?
										<= Cfp_text $mol_view sub / \Мы всегда ищем инженерный опыт, кейсы оптимизации, разборы фреймворков и дерзкие эксперименты. Поможем с подготовкой и презентацией.
										<= Cfp_link $mol_link
											uri \#!wiki/=uxgccs_dqplnq
											sub / \[ ПОДАТЬ ЗАЯВКУ НА ДОКЛАД ]
								<= Venue $mol_view
									sub /
										<= Venue_badge $mol_view sub / \VENUE // ПЛОЩАДКА ПРОВЕДЕНИЯ
										<= Venue_title $mol_view sub / <= venue_title \
										<= Venue_lines $mol_view
											sub <= venue_lines /
										<= Venue_map $mol_link
											uri <= map_uri
											target \_blank
											sub / \[ Открыть на Яндекс Картах ↗ ]
				<= Archive $mol_view
					attr * id \archive
					sub /
						<= Archive_body $mol_view
							sub /
								<= Archive_title $mol_view sub / \АРХИВ МИТАПОВ
								<= Archive_filters $mol_view
									sub <= filters /
								<= Archive_grid $mol_view
									sub <= cards /
								<= Archive_foot $mol_view
									sub <= archive_foot /
				<= Community $mol_view
					attr * id \community
					sub /
						<= Community_body $mol_view
							sub /
								<= Community_title $mol_view sub / \СООБЩЕСТВО
								<= Community_cards $mol_view
									sub <= community_cards /
				<= Foot $mol_view
					dom_name \footer
					sub /
						<= Foot_body $mol_view
							sub /
								<= Foot_row $mol_view
									sub /
										<= Foot_brand $mol_view
											sub /
												<= Foot_logo $mol_image
													uri \/piterjs/landing/assets/logo.webp
												<= Foot_copy $mol_view sub / \© 2026 PITERJS COMMUNITY // ST. PETERSBURG
										<= Foot_socials $mol_view
											sub <= socials /
								<= Foot_credit $mol_view
									sub /
										<= Foot_credit_title $mol_view sub / \ENGINE & UI /
										<= Foot_credit_link $mol_link
											uri \https://dev-by-yurii.vercel.app
											target \_blank
											sub / \DEV-BY-YURII.RU
	Nav_link!id $mol_link
		uri <= nav_uri!id \
		click? <=> menu_close? null
		sub / <= nav_title!id \
	Timer!id $mol_view
		sub /
			<= Timer_value!id $mol_view sub / <= timer_value!id \
			<= Timer_title!id $mol_view sub / <= timer_title!id \
	Join_free $mol_view sub / <= join_free \
	Join_name $mol_string
		hint \Имя Фамилия
		value? <=> name_real? \
		enabled <= join_name_enabled true
	Join_check $mol_check_box
		title \Я приду
		checked? <=> joined? false
		enabled <= join_enabled false
	Join_hint $mol_view sub / <= join_hint \
	Talk!id $mol_view
		sub /
			<= Talk_time!id $mol_view sub / <= talk_time!id \
			<= Talk_title!id $mol_view sub / <= talk_title!id \
			<= Talk_lead!id $mol_view sub / <= talk_lead!id \
			<= Talk_speaker!id $mol_view
				sub <= talk_speaker!id /
	Talk_photo!id $mol_image
		uri <= talk_photo_uri!id \
	Talk_person!id $mol_view
		sub /
			<= Talk_person_name!id $mol_view sub / <= talk_person_name!id \
			<= Talk_person_role!id $mol_view sub / <= talk_person_role!id \
	Venue_line!id $mol_view sub / <= venue_line!id \
	Filter!id $mol_button_minor
		attr *
			^
			piterjs_landing_filter_current <= filter_current!id false
		click? <=> filter_click!id? null
		sub / <= filter_title!id \
	Card!id $mol_link
		arg *
			landing null
			meetup <= card_meetup!id \
		sub /
			<= Card_tag!id $mol_view sub / <= card_tag!id \
			<= Card_title!id $mol_view sub / <= card_title!id \
			<= Card_date!id $mol_view sub / <= card_date!id \
	More $mol_button_minor
		click? <=> more_click? null
		sub / \[ ПОКАЗАТЬ ЕЩЁ ]
	Community_card!id $mol_view
		sub /
			<= Community_badge!id $mol_view sub / <= community_badge!id \
			<= Community_card_title!id $mol_view sub / <= community_title!id \
			<= Community_text!id $mol_view sub / <= community_text!id \
			<= Community_link!id $mol_link
				uri <= social_uri!id \
				target \_blank
				sub / <= community_action!id \
	Social!id $mol_link
		uri <= social_uri!id \
		target \_blank
		hint <= social_hint!id \
		sub /
			<= Social_icon!id $mol_image
				uri <= social_icon!id \
